# RevBid Server Environment Variables Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/car-auction

# JWT Authentication Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET=revbid_jwt_access_token_secret_32_characters_minimum
JWT_REFRESH_SECRET=revbid_jwt_refresh_token_secret_32_characters_minimum

# Allowed Client Origin for CORS and Socket.io (comma-separated or single URL)
CLIENT_ORIGIN=http://localhost:3000

# Stripe Payment Gateway (Test Mode Keys)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
